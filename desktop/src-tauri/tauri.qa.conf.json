{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyControl QA",
  "version": "0.1.0",
  "identifier": "com.easycontrol.desktop.qa",
  "build": {
    "beforeDevCommand": "VITE_EC_PROFILE=qa npm run dev",
    "beforeBuildCommand": "VITE_EC_PROFILE=qa npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [{ "label": "main", "title": "EasyControl QA", "width": 1200, "height": 800, "minWidth": 920, "minHeight": 640, "resizable": true }],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data:;" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "macOS": { "minimumSystemVersion": "10.15" },
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"]
  }
}
